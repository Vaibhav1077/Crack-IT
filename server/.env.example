# ============================================
# Crack-IT — Server Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file to git.
# ============================================

# MongoDB Connection String
# Get from: https://cloud.mongodb.com
MONGODB_URI=your_mongodb_connection_string

# Clerk Authentication
# Get from: https://dashboard.clerk.com -> API Keys
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# Encryption Secret (must be 64 hex characters / 32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET=your_64_char_hex_string_here

# Google Gemini API
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# Groq API (LLaMA models)
# Get from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key

# Judge0 Code Execution API
# Get from: https://rapidapi.com/judge0-official/api/judge0-ce
JUDGE0_API_KEY=your_rapidapi_key
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
